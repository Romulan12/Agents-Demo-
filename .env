# --- LLM provider ---
# Any OpenAI-compatible endpoint: real OpenAI, a LiteLLM gateway, Azure proxy,
# local vLLM, etc. Set OPENAI_BASE_URL to the gateway root; leave blank to hit
# api.openai.com directly.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://y...content-available-to-author-only...e.com/v1

# Default chat model + embeddings (LangChain init_chat_model identifiers).
# The "openai:" prefix means "use the OpenAI SDK" — the actual model is whatever
# the configured endpoint recognizes.
LLM_MODEL=openai:claude-sonnet-4-6
# Fast/cheap model for lightweight nodes (guards, router, query expansion).
# Leave blank to reuse LLM_MODEL. Set to a Haiku-tier model on your gateway
# (e.g. openai:claude-haiku-4-5) for ~30-50% lower end-to-end latency.
FAST_LLM_MODEL=openai:claude-haiku-4-5
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# --- Tracing (LangSmith) ---
# Get an API key at https://s...content-available-to-author-only...n.com — traces appear in the project below.
# Set LANGSMITH_TRACING=false to disable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-key-here
LANGSMITH_PROJECT=agentic-rag
# Leave blank for the default endpoint (https://a...content-available-to-author-only...n.com).
LANGSMITH_ENDPOINT=

# --- Prompt versioning (LangSmith Hub) ---
# Prompts are pulled from "<owner>/<repo>-<name>" at process start
# (e.g. "19407ced-.../agentic-rag-query_expansion"). Falls back to in-code
# constants if hub is unreachable or LANGSMITH_PROMPTS=false.
# Owner = workspace handle/UUID from https://s...content-available-to-author-only...n.com URL path /o/<owner>/...
LANGSMITH_PROMPTS=true
# Your LangSmith workspace handle or UUID (from the URL: /o/<owner>/...).
LANGSMITH_PROMPTS_OWNER=your-langsmith-workspace-id
LANGSMITH_PROMPTS_REPO=agentic-rag
# "latest" tracks edits in the hub UI; pin to a commit hash for reproducibility.
PROMPT_REVISION=latest

# --- Paths ---
DATASETS_DIR=./datasets
CHROMA_DIR=./data/chroma
CHECKPOINT_DB=./data/checkpoints.sqlite

# --- Behavior ---
MAX_REACT_ITERATIONS=4
